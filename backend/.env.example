PORT=8100
ORIGIN=http://localhost:5173
MONGO_URI=mongodb+srv://...

# Auth: long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AI provider (any OpenAI-compatible API). Defaults to Google Gemini.
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-flash-latest
# AI_FALLBACK_MODELS=gemini-flash-lite-latest

# OCR.space key (https://ocr.space/ocrapi)
# OCR_API_KEY=

# Daily analysis quotas (rolling 24h)
# USER_DAILY_LIMIT=10
# GUEST_DAILY_LIMIT=2
# GUEST_IP_DAILY_LIMIT=6
# MAX_UPLOAD_MB=5

# Set to 1 when running behind a reverse proxy so rate limits see real client IPs
# TRUST_PROXY=1
